        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    if (current.isNewRecord()) {

        // Move o incidente de "Novo" para "Em Triagem"
        current.state = 11; // Em Triagem

        // Define a prioridade automaticamente com base na categoria
        var categoria = current.categoria.toString();

        switch (categoria) {
            case 'falha_de_veiculo':
            case 'avaria_de_carga':
                current.priority = 2; // Alta
                break;
            case 'atraso_na_entrega':
            case 'divergencia_de_estoque':
            case 'problema_de_rota':
                current.priority = 3; // Moderada
                break;
            default: // outro
                current.priority = 4; // Baixa
        }
    }

})(current, previous);]]></script>
