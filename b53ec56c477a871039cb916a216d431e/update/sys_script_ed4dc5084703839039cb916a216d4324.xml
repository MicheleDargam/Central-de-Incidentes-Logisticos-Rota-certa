        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Só executa quando o Incidente muda de estado para "Resolvido" (14)
    if (!current.state.changesTo(14)) {
        return;
    }

    // Se não tiver Carga/Pedido vinculado, não faz nada
    if (current.carga_pedido.nil()) {
        return;
    }

    var carga = current.carga_pedido.getRefRecord();
    if (carga.isValidRecord()) {
        carga.status = 'entregue';
        carga.update();
    }

})(current, previous);]]></script>
